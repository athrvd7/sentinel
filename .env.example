# Production requires both values; authentication is unavailable when either is missing.
INVESTIGATOR_PASSWORD=replace-with-a-strong-investigator-password
SESSION_SECRET=replace-with-a-long-random-session-secret

# Local development only: explicitly enables the sentinel-demo password and a random per-process session secret.
SENTINEL_DEMO_MODE=true

# Optional local Kubo/IPFS service. Without it, encrypted blobs use the marked development fallback.
IPFS_API_URL=http://127.0.0.1:5001

# Optional local Anvil contract relay. Without these values, proof references use the marked development fallback.
ANVIL_RPC_URL=http://127.0.0.1:8545
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
RELAY_PRIVATE_KEY=0xreplace-with-anvil-private-key
